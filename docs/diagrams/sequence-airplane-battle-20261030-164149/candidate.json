  "cards": [
    {
      "dot": "cyan",
      "title": "一帧的骨架",
      "items": [
        "顺序按源码：先 handle_events()，再取 now，再分 paused 分支",
        "paused 分支只绘制 + tick(60)，不进入 update()",
        "smoke-test 模式用 _NONE_KEYS 顶替真实按键，自动开火"
      ]
    },
    {
      "dot": "rose",
      "title": "返回值与状态回传",
      "items": [
        "Player.hit() 返回布尔：无敌帧内 False，不扣血也不生成爆炸",
        "SoundBoard.play() 返回 None：enabled / muted 为假时直接 return",
        "pygame.time.Clock.tick() 返回本帧毫秒，play() 结束返回 0"
      ]
    },
    {
      "dot": "slate",
      "title": "被省略的路径",
      "items": [
        "引导页 show_instructions()、素材与音效加载、main() 启动",
        "子弹与敌机的越界剔除写在 update() 内，用列表推导完成",
        "死亡后 _wait_with_events() 内部循环 draw() + tick(60)"
      ]
    }
  ]
